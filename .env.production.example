APP_NAME="Policy in Action Library Backend"
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_ENABLED=true
# When running via docker compose, DATABASE_URL is injected from compose.yaml (points to db:5432).
# Only set this manually when running the backend outside of Docker.
DATABASE_URL=postgresql+asyncpg://appuser:replace-with-database-password@localhost:5432/testdb

DOCUMENT_STORAGE_DIR=data/pdfs
VECTOR_INDEX_DIR=data/vector_index

APP_SECRET=replace-with-a-long-random-secret

# Registration email verification. Use "development" for a local demo (the UI
# displays the code) or "smtp" in a deployed environment.
EMAIL_VERIFICATION_MODE=development
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_USE_TLS=true
