APP_NAME="Policy in Action Library Backend"
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_ENABLED=true
DATABASE_URL=postgresql+asyncpg://appuser:replace-with-database-password@127.0.0.1:5432/testdb

CRAWLING_ENABLED=false
DOCUMENT_STORAGE_DIR=data/pdfs
VECTOR_INDEX_DIR=data/vector_index

APP_SECRET=replace-with-a-long-random-secret
