# Optional overrides for the repository-root compose.yaml. `docker compose up`
# works without this file. The standalone backend does not read this file.

# Database traffic is isolated inside the Compose network and is not published.
DB_PASSWORD=replace-with-a-long-random-password

# Optional explicit token-signing secret. Normally leave blank: the backend
# generates a unique secret in backend/data/app_secret on first use.
APP_SECRET=

# Per backend process: Repository connection pool and bounded file uploads.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT=2
DATABASE_POOL_MAX_WAITING=20
DATABASE_CONNECT_TIMEOUT=3
DATABASE_POOL_STARTUP_TIMEOUT=5
DATABASE_POOL_PRE_PING=true
UPLOAD_MAX_BYTES=20971520
UPLOAD_CHUNK_BYTES=1048576
UPLOAD_REQUEST_OVERHEAD_BYTES=262144

# Durable document processing. The API runs none; this is the task concurrency of
# each `worker` replica (scale replicas with `docker compose up --scale worker=N`).
DOCUMENT_TASK_WORKERS=3
DOCUMENT_TASK_POLL_SECONDS=1
DOCUMENT_TASK_LEASE_SECONDS=30
DOCUMENT_TASK_HEARTBEAT_SECONDS=5
DOCUMENT_TASK_MAX_ATTEMPTS=3
DOCUMENT_TASK_RETRY_SECONDS=2
DOCUMENT_TASK_EXECUTION_TIMEOUT_SECONDS=300

# Internal Redis for the taxonomy cache and per-user rate limits (not published).
# With rate limits on, chat/resume/upload return 503 while Redis is unreachable.
REDIS_ENABLED=true
REDIS_KEY_PREFIX=policy:prod
REDIS_MAXMEMORY=64mb
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_LIMIT=10
RATE_LIMIT_RESUME_LIMIT=20
RATE_LIMIT_UPLOAD_LIMIT=5

# Host folder for uploads, secrets, model cache and logs (outside the checkout).
POLICY_DATA_DIR=../policy-library-data
# Chat turns running at once per API process; extra requests wait, then get 503.
CHAT_MAX_CONCURRENT_TURNS=8
CHAT_QUEUE_WAIT_SECONDS=10
