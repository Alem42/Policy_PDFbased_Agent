# Standalone backend-development settings. Docker Compose does not read this
# file; container settings live in the repository-root compose.yaml.
APP_NAME=AI Policy Research Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
APP_SECRET=
APP_SECRET_FILE=data/app_secret

# Standalone PostgreSQL reservation. It is disabled by default; only uncomment
# DATABASE_URL when deliberately running this backend outside Docker Compose.
DATABASE_ENABLED=false
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_policy
DATABASE_POOL_PRE_PING=false

# Local semantic embedding model. The configured model must output 384 dimensions
# to match database/init.sql (vector(384)).
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
DEFAULT_EMBEDDING_DIMENSIONS=384
MODEL_CACHE_DIR=data/model_cache

# OCR support for scanned/image-only PDF pages. Requires the tesseract-ocr
# system binary (see Dockerfile / README) in addition to the pip package.
OCR_MIN_TEXT_CHARS=20
OCR_LANGUAGES=eng

# Optional fallback provider.
FIRECRAWL_API_KEY=
