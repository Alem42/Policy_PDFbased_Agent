# Standalone backend-development settings. Docker Compose does not read this
# file; container settings live in the repository-root compose.yaml.
APP_NAME=AI Policy Research Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
APP_SECRET=
# Optional explicit key for encrypting provider API keys at rest (a Fernet key).
# Normally blank: a key is generated in DATA_ROOT/secrets/settings.key.
SETTINGS_ENCRYPTION_KEY=

# Standalone PostgreSQL reservation. It is disabled by default; only uncomment
# DATABASE_URL when deliberately running this backend outside Docker Compose.
DATABASE_ENABLED=false
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_policy
DATABASE_POOL_PRE_PING=false
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT=2
DATABASE_POOL_MAX_WAITING=20
DATABASE_CONNECT_TIMEOUT=3
DATABASE_POOL_STARTUP_TIMEOUT=5

# Redis is optional. One shared async client per API process; no automatic retries.
REDIS_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_LIMIT=10
RATE_LIMIT_RESUME_LIMIT=20
RATE_LIMIT_UPLOAD_LIMIT=5
# Development-only admin test endpoint; keep off outside the interview demo.
REDIS_DEMO_ENABLED=false
REDIS_DEMO_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=policy:dev
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=0.2
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
REDIS_OPERATION_BUDGET_SECONDS=0.3
TAXONOMY_CACHE_ENABLED=true
TAXONOMY_CACHE_TTL_SECONDS=60
TAXONOMY_CACHE_WAIT_SECONDS=0.5
TAXONOMY_CACHE_MAX_BYTES=262144

# File size and bounded copy buffers (bytes); each upload is one multipart request.
UPLOAD_MAX_BYTES=20971520
UPLOAD_CHUNK_BYTES=1048576
UPLOAD_REQUEST_OVERHEAD_BYTES=262144

# Everything the backend writes: uploads/, secrets/, model-cache/, logs/.
# data/ at the project root (git-ignored). Move an existing backend/data with
# `python -m app.modules.documents.migrate_storage --data-root ../data --apply`.
DATA_ROOT=../data

# Durable PostgreSQL tasks. Set workers=0 when using a separate worker process.
DOCUMENT_TASK_WORKERS=3
DOCUMENT_TASK_POLL_SECONDS=1
DOCUMENT_TASK_LEASE_SECONDS=30
DOCUMENT_TASK_HEARTBEAT_SECONDS=5
DOCUMENT_TASK_MAX_ATTEMPTS=3
DOCUMENT_TASK_RETRY_SECONDS=2
DOCUMENT_TASK_EXECUTION_TIMEOUT_SECONDS=300

# Local semantic embedding model. The configured model must output 384 dimensions
# to match database/init.sql (vector(384)).
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
DEFAULT_EMBEDDING_DIMENSIONS=384

# OCR support for scanned/image-only PDF pages. Requires the tesseract-ocr
# system binary (see Dockerfile / README) in addition to the pip package.
OCR_MIN_TEXT_CHARS=20
OCR_LANGUAGES=eng

# Optional fallback provider.
FIRECRAWL_API_KEY=
